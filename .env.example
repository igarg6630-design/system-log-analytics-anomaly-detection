# SQL: default SQLite (zero setup). MySQL ke liye neeche wali line use karo
SQL_URL=sqlite:///./logs.db
# SQL_URL=mysql+pymysql://user:password@localhost:3306/log_analytics

# MongoDB (agar na chale to app in-memory store par fallback ho jaata hai)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=log_analytics
MONGO_TIMEOUT_MS=2000

MAX_UPLOAD_MB=50
